# weights and checkpoints never belong in the build context (the image pulls the one
# demo model it needs)
models/
*.gguf
*.safetensors
*.bin
*.npy
*.shape

# build trees and local scratch
build/
build-*/
ref_*/
.venv/
.venv-*/
.git/
tmp_*/
*.log

# libjpeg-turbo ditto (cloned inside the image, see the build stage)
vendor/libjpeg-turbo/
# ggml is fetched inside the image (add_subdirectory(ggml)); shipping a local
# checkout would add ~100 MB to the context and make the build non-reproducible
ggml/
